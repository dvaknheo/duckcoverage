{
    "name": "dvaknheo/duckcoverage",
    "description": "duckphp ext for test coverage",
    "type": "library",
    "keywords": [
        "coverage",
        "duckphp"
    ],
    "homepage": "https://www.github.com/dvaknheo/duckcoverage",
    "license": "MIT",
    "authors": [
        {
            "name": "dvaknheo",
            "email": "dvaknheo@qq.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "DuckCoverage\\": "src/"
        }
    },
    "require": {
        "php": ">=8.4.0",
        "dvaknheo/libcoverage": "1.0.8"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../DNMVCS",
            "options": {
                "symlink": true
            }
        },
        {
            "type": "path",
            "url": "../libcoverage",
            "options": {
                "symlink": true
            }
        }
    ],
    "require-dev": {
        "dvaknheo/duckphp": "1.4.1",
        "phpunit/php-code-coverage": "^11.0",
        "phpunit/phpunit": "^11.0"
    },
    "scripts": {
        "fulltest": [
            "phpunit",
            "phpunit tests/support.php"
        ],
        "singletest": [
            "phpunit",
            "phpunit tests/support.php"
        ]
    }
}
